---
/**
 * HeroDates — fechas del viaje en la cabecera del título: dos hojas de calendario arrancables
 * (himekuri) con la salida y el regreso, unidas por la duración, y la cuenta atrás.
 *
 * Todo sale de los datos (tripSummary + ayudas de fechas de trip.ts): mes en kanji, día de la
 * semana y cifras. Las hojas se leen como una imagen con el rango en palabras («Del 7 al 28 de
 * mayo de 2027») y conservan sus <time datetime>. La cuenta atrás se calcula en el build y
 * scripts/countdown.ts la recalcula en el cliente al cargar (si no, quedaría congelada en la
 * fecha del build): sus huecos son [data-countdown-value] y [data-countdown-label].
 * Estilos y entrada en index.css (`[data-hero-dates]`…).
 */
import { calendarDay, countdownText, formatDateSpan, localIsoDate, tripCountdown, tripSummary } from '@/data/trip'

const trip = tripSummary()
const pages = [
  { date: calendarDay(trip.departure), which: 'salida' },
  { date: calendarDay(trip.returnDate), which: 'regreso' },
] as const
const rango = formatDateSpan(trip.departure, trip.returnDate)
const { value, label } = countdownText(tripCountdown(trip.departure, trip.returnDate, localIsoDate(new Date())))
---

<div data-hero-dates>
  <div data-himekuri role="img" aria-label={rango}>
    {
      pages.map(({ date, which }, i) => (
        <>
          {i > 0 && (
            <span data-cal-span><span data-cal-len>{trip.days} días</span><span data-cal-line></span></span>
          )}
          <time datetime={date.iso} data-cal-page={which}><span data-cal-ring></span><span data-cal-ring></span><span data-cal-month><span lang="ja">{date.monthKanji}</span><small>{date.monthName}</small></span><span data-cal-num>{date.day}</span><span data-cal-weekday><span lang="ja">{date.weekdayKanji}</span> · {date.weekdayShort}</span></time>
        </>
      ))
    }
  </div>

  <p data-countdown data-departure={trip.departure} data-return={trip.returnDate}><strong data-countdown-value>{value}</strong> <span data-countdown-label>{label.map((line, i) => <>{i > 0 && ' '}<span>{line}</span></>)}</span></p>
</div>
