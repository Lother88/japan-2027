---
/**
 * ArtBox — caja de tamaño fijo para un spot isométrico (sustituye a LazyIso).
 *
 * La caja (span, válida dentro de botones y casillas) reserva el tamaño desde el HTML, así que
 * la llegada del SVG no mueve nada. Es decorativa: aria-hidden.
 *
 * Contrato con el arte (Fase 3):
 *  - `data-art` es el nombre del hueco (lo usa index.css: `[data-art="banda"]`, `[data-ticket-cell] [data-art]`).
 *  - `data-art-src` es la clave del asset en el registro (`banda`, `ruta`, `omamori`, `koyomi`…).
 *  - `data-art-defer`: se descarga al acercarse al viewport (scripts/lazy-art.ts).
 *  - `data-art-pause`: congela sus animaciones mientras no se ve (pone `data-art-paused`).
 *  - `data-art-par`: preserveAspectRatio del SVG (por defecto `xMidYMid meet`).
 */
import { css, type StyleObject } from '@/lib/style'

interface Props {
  /** Nombre del hueco (`data-art`). */
  name: string
  /** Clave del asset en el registro de arte. */
  src: string
  defer?: boolean
  pauseOffscreen?: boolean
  preserveAspectRatio?: string
  style?: StyleObject
}

const { name, src, defer = false, pauseOffscreen = false, preserveAspectRatio, style } = Astro.props
---

<span
  data-art={name}
  data-art-src={src}
  data-art-defer={defer ? '' : undefined}
  data-art-pause={pauseOffscreen ? '' : undefined}
  data-art-par={preserveAspectRatio}
  aria-hidden="true"
  style={css({ display: 'block', flex: 'none', pointerEvents: 'none', position: 'relative' }, style)}
><slot /></span>
