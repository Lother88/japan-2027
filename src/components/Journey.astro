---
/**
 * Journey — contenedor del itinerario completo.
 *
 * Escritorio: rail sticky (DayRail, <nav>) + lista de días (DaySection por día), hermanos
 * dentro de [data-journey]. Móvil (≤ 860 px): el rail se oculta y manda la tira de fechas
 * sticky (DateStrip) encima de los días. `#itinerario` es el destino del skip-link; el día
 * activo lo llevan scripts/journey.ts (rail y tira) y el plan de hoy scripts/day-plan.ts.
 *
 * Al final, un <template data-zone-tpl> por zona usada en algún paso: la hoja de cada paso
 * (StepSheet + scripts/sheet.ts) clona de ahí la ficha de la zona y su «El lugar» plegado.
 * Los <template> no se pintan ni cargan nada hasta que se clonan. Solo llevan lo práctico:
 * el contexto cultural de «El lugar» es JSON aparte (scripts/place.ts, al desplegarlo).
 */
import { getZone, itinerary } from '@/data'
import type { Zone } from '@/data/types'
import DayRail from '@/components/DayRail.astro'
import DateStrip from '@/components/DateStrip.astro'
import DaySection from '@/components/DaySection.astro'
import JourneyIcons from '@/components/JourneyIcons.astro'
import ZoneCard from '@/components/ZoneCard.astro'

const zoneIds = [...new Set(itinerary.flatMap((d) => d.steps.flatMap((s) => (s.zoneId ? [s.zoneId] : []))))]
const zones = zoneIds.map((id) => getZone(id)).filter((z): z is Zone => z !== undefined)
---

<section id="itinerario" aria-label="Itinerario día a día" data-journey>
  <JourneyIcons />
  <DayRail days={itinerary} />

  <div data-days>
    <DateStrip days={itinerary} />
    {itinerary.map((day) => <DaySection day={day} />)}
  </div>

  {
    zones.map((zone) => (
      <template data-zone-tpl={zone.id}>
        <ZoneCard zone={zone} />
      </template>
    ))
  }
</section>
