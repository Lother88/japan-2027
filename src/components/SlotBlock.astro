---
/**
 * SlotBlock — media jornada (mañana / tarde) de un día: etiqueta vertical con su punto de color,
 * resumen y las tarjetas de las zonas que se visitan.
 */
import type { TimeSlot } from '@/data/types'
import type { ThemeTokens } from '@/features/landing/theme'
import { getZone } from '@/data'
import { fontSans } from '@/features/landing/theme'
import { css } from '@/lib/style'
import ZoneCard from '@/components/ZoneCard.astro'

interface Props {
  timeSlot: TimeSlot
  tokens: ThemeTokens
}

const SLOT_LABELS: Record<string, string> = {
  morning: 'Mañana',
  afternoon: 'Tarde',
}

const { timeSlot: slot, tokens } = Astro.props
const label = SLOT_LABELS[slot.key] ?? slot.label
const dot = slot.key === 'morning' ? tokens.morningDot : tokens.afternoonDot

const resolvedZones = slot.zones
  .map((ref) => getZone(ref.zoneId))
  .filter((z): z is NonNullable<typeof z> => z !== undefined)
---

<div style={css({ display: 'flex', gap: 16 })}>
  {/* Etiqueta vertical */}
  <div style={css({ flex: 'none', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 9, paddingTop: 3 })} aria-hidden="true">
    <span style={css({ flex: 'none', width: 7, height: 7, borderRadius: '50%', background: dot })}></span>
    <span
      style={css({
        fontFamily: fontSans,
        fontSize: 11,
        fontWeight: 700,
        letterSpacing: '0.1em',
        color: dot,
        writingMode: 'vertical-rl',
        textTransform: 'uppercase',
      })}
    >{label}</span>
    <span style={css({ flex: 1, width: 2, borderRadius: 2, background: dot, opacity: 0.24 })}></span>
  </div>

  {/* Contenido */}
  <div style={css({ flex: 1, display: 'flex', flexDirection: 'column', gap: 14 })}>
    {/* Resumen */}
    <div style={css({ background: 'var(--surface)', border: '1px solid var(--border)', borderRadius: 14, padding: '20px 22px' })}>
      <p style={css({ margin: 0, fontFamily: fontSans, fontSize: 15, lineHeight: 1.65, color: 'var(--body)' })}>{slot.summary}</p>
    </div>

    {/* Zonas */}
    {resolvedZones.map((zone) => <ZoneCard zone={zone} tokens={tokens} />)}
  </div>
</div>
