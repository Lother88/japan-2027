---
/**
 * TransferCard — «billete» de un trayecto del día: cabecera (🧳 Traslado o Ida y vuelta + modo),
 * origen → destino, perforado, línea y duración, y las notas (transbordos, equipaje, reservas).
 * Franja lateral con el color de la ciudad del día (--c, heredado de la sección). Estilos en
 * index.css («Journey · billete»).
 */
import type { Transfer } from '@/data/types'
import { TRANSFER_MODE_LABELS } from '@/features/landing/dayView'
import Icon from '@/components/Icon.astro'

interface Props {
  transfer: Transfer
}

const { transfer: t } = Astro.props
const kind = t.roundTrip ? 'Ida y vuelta' : 'Traslado'
---

<section data-transfer aria-label={`${kind}: de ${t.from} a ${t.to}`}>
  <p data-tr-head>
    {!t.roundTrip && <span aria-hidden="true">🧳</span>}
    <span>{kind} · {TRANSFER_MODE_LABELS[t.mode]}</span>
  </p>
  <div data-tr-route>
    <p data-tr-end><small>Desde</small><strong>{t.from}</strong></p>
    <span data-tr-arrow><Icon name="arrow" size={22} /></span>
    <p data-tr-end="to"><small>Hasta</small><strong>{t.to}</strong></p>
  </div>
  <div data-tr-perf aria-hidden="true"></div>
  {
    (t.line || t.duration) && (
      <dl data-tr-facts>
        {t.line && (
          <>
            <dt>Cómo</dt>
            <dd>{t.line}</dd>
          </>
        )}
        {t.duration && (
          <>
            <dt>Duración</dt>
            <dd>{t.duration}</dd>
          </>
        )}
      </dl>
    )
  }
  {
    t.notes && t.notes.length > 0 && (
      <ul data-tr-notes>
        {t.notes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    )
  }
</section>
