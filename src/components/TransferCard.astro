---
/**
 * TransferCard — tarjeta de un trayecto (tren o bus) del día: icono del modo, duración,
 * origen → destino, línea y notas. Oscura en ambos temas (tokens transfer* de theme.ts).
 */
import type { Transfer } from '@/data/types'
import type { ThemeTokens } from '@/features/landing/theme'
import { fontSerif, fontSans } from '@/features/landing/theme'
import { css } from '@/lib/style'

interface Props {
  transfer: Transfer
  tokens: ThemeTokens
}

const { transfer, tokens } = Astro.props
const isBus = transfer.mode === 'bus'
---

<div
  style={css({
    display: 'flex',
    gap: 14,
    alignItems: 'flex-start',
    background: tokens.transferBg,
    color: tokens.transferText,
    borderRadius: 14,
    padding: '18px 20px',
  })}
>
  {/* Icono del modo */}
  <div
    style={css({
      flex: 'none',
      width: 38,
      height: 38,
      borderRadius: 9,
      background: tokens.transferIconBg,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
    })}
    aria-hidden="true"
  >
    {
      isBus ? (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={tokens.transferIconStroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 13h18l-2-5a3 3 0 0 0-3-2H8a3 3 0 0 0-3 2z" />
          <path d="M3 13v4h18v-4M7 21l1-2m9 2l-1-2" />
          <circle cx="7.5" cy="17" r="1" />
          <circle cx="16.5" cy="17" r="1" />
        </svg>
      ) : (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={tokens.transferIconStroke} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="3" width="12" height="14" rx="3" />
          <path d="M6 11h12M9 21l-2 2m10-2l2 2" />
          <circle cx="9" cy="14" r="1" />
          <circle cx="15" cy="14" r="1" />
        </svg>
      )
    }
  </div>

  {/* Contenido */}
  <div style={css({ flex: 1, minWidth: 0 })}>
    {/* Antetítulo + duración */}
    <div style={css({ display: 'flex', alignItems: 'center', gap: 9, flexWrap: 'wrap' })}>
      <span
        style={css({
          fontFamily: fontSans,
          fontSize: 10,
          letterSpacing: '0.18em',
          textTransform: 'uppercase',
          color: tokens.transferEyebrow,
          fontWeight: 700,
        })}
      >Trayecto · {transfer.mode}</span>
      {
        transfer.duration && (
          <span
            style={css({
              fontFamily: fontSans,
              fontSize: 11,
              color: tokens.transferMuted,
              background: 'rgba(255,255,255,.08)',
              padding: '2px 9px',
              borderRadius: 20,
            })}
          >{transfer.duration}</span>
        )
      }
    </div>

    {/* Origen → destino */}
    <div style={css({ fontFamily: fontSerif, fontSize: 18, fontWeight: 600, marginTop: 5, color: tokens.transferText })}>
      {transfer.from} → {transfer.to}
    </div>

    {/* Línea */}
    {transfer.line && <div style={css({ fontFamily: fontSans, fontSize: 13, color: tokens.transferMuted, marginTop: 3 })}>{transfer.line}</div>}

    {/* Notas */}
    {
      transfer.notes && transfer.notes.length > 0 && (
        <ul style={css({ margin: '11px 0 0', padding: 0, listStyle: 'none', display: 'flex', flexDirection: 'column', gap: 5 })}>
          {transfer.notes.map((nota) => (
            <li style={css({ display: 'flex', gap: 8, fontFamily: fontSans, fontSize: 13, color: tokens.transferText })}>
              <span style={css({ color: tokens.transferIconStroke })} aria-hidden="true">·</span>{nota}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
