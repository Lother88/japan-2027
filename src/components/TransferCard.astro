---
/**
 * TransferCard — el trayecto de un paso, dentro de su hoja (StepSheet).
 *
 * Journey.astro la pinta una vez por paso con trayecto dentro de un
 * <template data-transfer-tpl="id del paso"> y scripts/sheet.ts la clona al abrir ese paso,
 * antes de la ficha de la zona: Cómo, Duración y los avisos (transbordos, equipaje, asientos).
 * Sin línea de ruta visible: el destino ya es el título del paso, el modo su icono y el origen
 * va en «Cómo»; Desde → Hasta solo queda como nombre accesible del bloque. «Con maletas» o «ida y vuelta» no
 * van aquí: son marcas del paso (StepTimeline), que la hoja ya copia. Estilos en index.css
 * («Trayecto en la hoja»).
 */
import type { Transfer } from '@/data/types'

interface Props {
  transfer: Transfer
}

const { transfer: t } = Astro.props
---

<div data-transfer role="group" aria-label={`Trayecto de ${t.from} a ${t.to}`}>
  {
    (t.line || t.duration) && (
      <dl data-tr-facts>
        {t.line && (
          <>
            <dt>Cómo</dt>
            <dd>{t.line}</dd>
          </>
        )}
        {t.duration && (
          <>
            <dt>Duración</dt>
            <dd>{t.duration}</dd>
          </>
        )}
      </dl>
    )
  }
  {
    t.notes && t.notes.length > 0 && (
      <ul data-tr-notes aria-label="Avisos del trayecto">
        {t.notes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    )
  }
</div>
