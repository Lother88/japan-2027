---
/**
 * SiteFooter — pie de página de la landing.
 * Fondo navy oscuro (#14203a), resumen del viaje (cifras derivadas de los datos)
 * y notas del viaje. La marca es el spot isométrico de un omamori (amuleto), generado para
 * este azul fijo del pie, así que no cambia con el tema. Se descarga al acercarse al viewport.
 */
import { tripSummary } from '@/data/trip'
import { css } from '@/lib/style'
import ArtBox from '@/components/ArtBox.astro'

const trip = tripSummary()

const chipStyle = css({
  fontSize: '12px',
  color: '#cdd6e7',
  background: 'rgba(255,255,255,.06)',
  border: '1px solid rgba(255,255,255,.1)',
  padding: '5px 12px',
  borderRadius: '20px',
})

const notes = ['Hiroshima sin pernocta', 'Shirakawa-go sin maletas', 'Fuji desde el shinkansen', 'Miyajima, para otro viaje']
---

<footer
  style={css({
    position: 'relative',
    background: '#14203a',
    color: '#b9c4db',
    padding: 'clamp(44px,7vh,80px) clamp(24px,5vw,56px) 56px',
    overflow: 'hidden',
  })}
>
  <div style={css({ maxWidth: '1100px', margin: '0 auto' })}>
    <div
      style={css({
        display: 'flex',
        flexWrap: 'wrap',
        gap: '32px',
        justifyContent: 'space-between',
        alignItems: 'flex-start',
      })}
    >
      {/* Bloque izquierdo — identidad */}
      <div style={css({ maxWidth: '340px' })}>
        <div style={css({ display: 'flex', alignItems: 'center', gap: '11px', marginBottom: '14px' })}>
          <ArtBox name="omamori" src="omamori" defer style={{ width: '40px', height: '48px' }} />
          <span style={css({ fontFamily: 'var(--font-serif)', fontSize: '18px', color: '#fdf3e7', fontWeight: 700 })}>Japón 2027</span>
        </div>
        <p style={css({ fontSize: '13.5px', lineHeight: 1.6, margin: 0, color: '#9fb0d0' })}>
          Ruta redonda por Narita · {trip.dateRange} · {trip.nights} noches en Japón · {trip.bases} bases · {trip.excursions} excursiones · {trip.travelers} viajeros · eje cultura.
        </p>
      </div>

      {/* Bloque derecho — notas del viaje */}
      <div>
        <div
          style={css({
            fontSize: 'var(--text-label)',
            letterSpacing: 'var(--text-label--letter-spacing)',
            textTransform: 'uppercase',
            color: '#f6c2d2',
            fontWeight: 700,
            marginBottom: '12px',
          })}
        >
          Notas del viaje
        </div>
        <div style={css({ display: 'flex', flexWrap: 'wrap', gap: '8px', maxWidth: '420px' })}>
          {notes.map((note) => <span style={chipStyle}>{note}</span>)}
        </div>
      </div>
    </div>

    {/* Línea inferior */}
    <div
      style={css({
        marginTop: '36px',
        paddingTop: '20px',
        borderTop: '1px solid rgba(255,255,255,.1)',
        display: 'flex',
        justifyContent: 'space-between',
        flexWrap: 'wrap',
        gap: '10px',
        fontSize: '12px',
        color: '#7d8aa6',
      })}
    >
      <span>Horarios de trenes y autobuses de 2026: revisar tras los cambios de marzo de 2027</span>
      <span>桜 · 日本一周</span>
    </div>
  </div>
</footer>
