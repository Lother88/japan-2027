---
/**
 * DaySection — un día del itinerario (ancla `#dia-NN`, `data-day` = id del día).
 *
 * De arriba abajo:
 *  - Cabecera: antetítulo (fecha · «Día N de 21»), ciudad, título serif, kanji vertical de la
 *    ciudad, chips de criterio (Fecha fija / Laborable / Primera oleada / Finde), 🧺 colada y
 *    la línea del hotel (zona + Maps + lavandería). Al lado (escritorio) o encima (móvil), la
 *    ilustración isométrica del día.
 *  - «Ahora / Después»: tarjeta vacía y oculta; scripts/day-plan.ts la rellena y la muestra solo
 *    en el día de hoy (hora de Japón, o la de la vista previa ?hoy=&hora=).
 *  - Reservas del día, notas del día (lo que vale para todo el día) y «El plan»
 *    (StepTimeline). Los trayectos no van aparte: son pasos del plan (marca «con maletas» o
 *    «ida y vuelta») y su detalle sale en la hoja del paso.
 *
 * El color de la ciudad va en --c (tono de index.css) y de ahí salen --c-ink/--c-soft/--c-line
 * ([data-tone]). Nada de experiencia por adelantado (NOSPOIL-02): el contexto cultural solo
 * está en la hoja de cada paso, plegado.
 *
 * Ilustración: caja `[data-illus]` con la proporción del viewBox común (440/330) reservada desde
 * el HTML; scripts/lazy-art.ts la rellena con el dibujo de `data-illus-kind` al acercarse.
 * content-visibility:auto solo en la caja (no en la sección): con secciones de altura estimada,
 * el día activo y los saltos a cada día medirían mal.
 */
import type { Day } from '@/data/types'
import { hotelForDay, reservationsForDay } from '@/data'
import { cityTone, dateParts, getCityMeta, pad2 } from '@/features/landing/theme'
import { pickIllustration } from '@/features/landing/illustrationKind'
import { dayAnchor } from '@/features/landing/scroll'
import { RULE_LABELS, cityName, dayPosition, daySubtitle, mapsUrl } from '@/features/landing/dayView'
import StepTimeline from '@/components/StepTimeline.astro'
import Icon from '@/components/Icon.astro'

interface Props {
  day: Day
}

const { day } = Astro.props
const city = cityName(day.citySlug)
const kanji = getCityMeta(day.citySlug).kanji
const date = dateParts(day.date)
const pos = dayPosition(day)
const titleId = `${dayAnchor(day.id)}-titulo`

/**
 * Mantiene enteras las palabras con guion («Shirakawa-go», «Kinkaku-ji»): con text-wrap:
 * balance el navegador prefería cortar tras el guion («Shirakawa-» / «go»).
 */
const subtitleParts = daySubtitle(day).split(/(\S+-\S+)/)

const rules = (day.rules ?? []).map((r) => RULE_LABELS[r])
const hotel = hotelForDay(day.id)
const reservations = reservationsForDay(day.id)
const notes = day.notes ?? []
const illustration = pickIllustration(day.id)
---

<section
  id={dayAnchor(day.id)}
  data-day={day.id}
  data-date={day.date}
  data-tone
  data-screen-label={`Día ${pad2(day.id)} · ${city}`}
  aria-labelledby={titleId}
  style={`--c:${cityTone(day.citySlug)}`}
>
  <div data-day-inner>
    <div data-day-top>
      <header data-day-head data-reveal>
        <div data-day-lede>
          <div data-day-text>
            <p data-day-eyebrow>{`${date.weekday} ${date.day} ${date.month}`} · Día {pos.n} de {pos.total}</p>
            <p data-day-city>{city}</p>
            <h2 data-day-title id={titleId}>
              {subtitleParts.map((part, i) => (i % 2 === 1 ? <span style="white-space:nowrap">{part}</span> : part))}
            </h2>
            {
              (rules.length > 0 || day.laundry) && (
                <ul data-day-chips aria-label="Criterios del día">
                  {rules.map((r) => (
                    <li data-rchip>
                      <i aria-hidden="true" />
                      {r.short}
                      <span class="sr-only">: {r.long}</span>
                    </li>
                  ))}
                  {day.laundry && (
                    <li data-rchip="laundry">
                      <span aria-hidden="true">🧺</span> Día de colada
                    </li>
                  )}
                </ul>
              )
            }
          </div>
          <span data-day-kanji aria-hidden="true">{kanji}</span>
        </div>
        {
          hotel && (
            <div data-day-hotel>
              <Icon name="bed" size={17} />
              <p>
                <span>Esta noche</span> {hotel.area}
                {hotel.laundry && <span data-hotel-laundry> · 🧺 con lavandería</span>}
              </p>
              <a href={mapsUrl(hotel.maps)} target="_blank" rel="noopener" aria-label={`Abrir la zona del hotel (${hotel.area}) en Google Maps`}>
                <Icon name="pin" size={20} />
              </a>
            </div>
          )
        }
      </header>

      {/* Ilustración isométrica del día (decorativa, carga diferida; nada si no hay) */}
      {illustration && <div data-illus data-illus-kind={illustration} aria-hidden="true"></div>}
    </div>

    {/* «Ahora / Después»: la rellena y la muestra scripts/day-plan.ts en el día de hoy */}
    <section data-now hidden aria-label="Ahora y después">
      <p data-now-head>
        <span>Hoy · <span data-now-clock></span> en Japón</span>
        <a data-now-preview hidden href="./">vista previa</a>
      </p>
      <div data-now-card>
        <button type="button" data-now-row="now" aria-haspopup="dialog">
          <span data-now-k><i aria-hidden="true"></i>Ahora</span>
          <span data-now-l></span>
          <span data-now-t></span>
        </button>
        <button type="button" data-now-row="next" aria-haspopup="dialog">
          <span data-now-k></span>
          <span data-now-l></span>
          <span data-now-t></span>
        </button>
        <p data-now-row="end">
          <span data-now-k>Después</span>
          <span data-now-l>Nada más en el plan. A descansar.</span>
        </p>
      </div>
    </section>

    {
      reservations.length > 0 && (
        <ul data-day-res aria-label="Reservas del día">
          {reservations.map((r) => (
            <li>
              <Icon name="ticket" size={18} />
              <p>
                <b>Reserva</b> {r.what}
                <small>{r.how}</small>
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {/* Lo que vale para todo el día, antes del plan (y solo aquí: la hoja del paso no lo repite) */}
    {
      notes.length > 0 && (
        <section data-day-notes aria-label="Notas del día">
          <h3>Notas del día</h3>
          <ul>
            {notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </section>
      )
    }

    <StepTimeline day={day} titleId={titleId} />
  </div>
</section>
