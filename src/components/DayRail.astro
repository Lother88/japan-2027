---
/**
 * DayRail — navegación sticky del journey en escritorio (`<nav aria-label="Días del viaje">`).
 * En móvil (≤ 860 px) se oculta: manda la tira de fechas (DateStrip).
 *
 * Día activo (kanji, «Día» + número real del día —el mismo del ancla de la sección—, ciudad,
 * fecha y posición «N de 21»), barra de progreso vertical y una lista de enlaces reales
 * `#dia-NN` (uno por día, zona táctil ≥ 24 px) con un punto del color de su ciudad.
 *
 * Los enlaces usan la navegación nativa por ancla (scroll suave por CSS), así que funcionan sin
 * JS y actualizan la URL.
 *
 * Estado activo sin plantillas en JS (lo gobierna scripts/journey.ts):
 *  - Los 21 bloques de «día activo» ([data-rail-block]) van pre-renderizados con
 *    `data-rail-day`; solo el del día activo no lleva `hidden` (sin JS, el primero).
 *  - Cada enlace del rail lleva `aria-current="location"` si es el activo y `data-passed` si ya
 *    se ha pasado; los estilos de los puntos salen de esos atributos (index.css, «Rail») y del
 *    tono de la ciudad en `--dot`.
 *  - Barra de progreso [data-rail-progress]: CSS scroll-driven o, sin soporte, el script.
 */
import type { Day } from '@/data/types'
import { cityTone, getCityMeta, formatShortDate, pad2, fontSerif } from '@/features/landing/theme'
import { cityName } from '@/features/landing/dayView'
import { dayAnchor } from '@/features/landing/scroll'
import { css } from '@/lib/style'

interface Props {
  days: readonly Day[]
}

const { days } = Astro.props

/** Día activo sin JS: el primero. */
const activeIndex = 0
---

<nav
  data-rail
  aria-label="Días del viaje"
  style={css({
    position: 'sticky',
    top: 0,
    width: '196px',
    height: '100vh',
    flexShrink: 0,
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'center',
    gap: '22px',
    // Abajo deja sitio al ThemeToggle flotante (26 + 50 px) para que no tape los últimos días.
    padding: '30px 20px 92px',
    borderRight: '1px solid var(--border)',
    background: 'var(--surface-warm)',
    zIndex: 5,
  })}
>
  {/* Bloques de info del día activo: uno por día, solo el activo visible */}
  {
    days.map((d, i) => (
      <div data-rail-block data-rail-day={d.id} hidden={i !== activeIndex} style={css({ display: 'flex', flexDirection: 'column', gap: '4px', position: 'relative' })}>
        {/* Marca de agua decorativa: el kanji va como contenido generado (index.css,
            [data-rail-kanji]::before) para que no cuente como texto de la página */}
        <span
          data-rail-kanji
          data-glyphs={getCityMeta(d.citySlug).kanji}
          aria-hidden="true"
          style={css({
            fontFamily: fontSerif,
            fontSize: '40px',
            lineHeight: 1,
            color: 'color-mix(in srgb, var(--ink) 13%, transparent)',
            fontWeight: 800,
            marginBottom: '6px',
          })}
        ></span>
        <span
          style={css({
            fontSize: 'var(--text-label)',
            lineHeight: 'var(--text-label--line-height)',
            letterSpacing: 'var(--text-label--letter-spacing)',
            textTransform: 'uppercase',
            color: 'var(--amber-text)',
            fontWeight: 700,
          })}
        >Día</span>
        <span data-rail-num style={css({ fontFamily: fontSerif, fontWeight: 800, fontSize: '74px', lineHeight: 0.9, color: 'var(--ink)' })}>{pad2(d.id)}</span>
        <span style={css({ fontFamily: fontSerif, fontSize: '22px', color: cityTone(d.citySlug), fontWeight: 600 })}>{cityName(d.citySlug)}</span>
        <span style={css({ fontSize: '13px', color: 'var(--muted2)', letterSpacing: '.04em' })}>{formatShortDate(d.date)}</span>
        <span data-rail-position style={css({ fontSize: '12px', color: 'var(--muted2)', fontVariantNumeric: 'tabular-nums' })}>{`${i + 1} de ${days.length}`}</span>
      </div>
    ))
  }

  {/* Barra de progreso vertical + enlaces por día */}
  <div data-prog-vertical style={css({ display: 'flex', gap: '14px', alignItems: 'stretch' })}>
    {/* Línea de progreso */}
    <div aria-hidden="true" style={css({ position: 'relative', width: '3px', background: 'var(--chip-cream)', borderRadius: '2px' })}>
      {/* A tamaño completo y escalada: el script escribe el transform (composited, sin layout) */}
      <div
        data-rail-progress="v"
        style={css({
          position: 'absolute',
          top: 0,
          left: 0,
          width: '100%',
          background: 'linear-gradient(180deg,var(--coral),var(--coral2))',
          borderRadius: '2px',
          height: '100%',
          transformOrigin: 'top',
          transform: 'scaleY(0)',
        })}
      ></div>
    </div>

    {/* Un enlace por día */}
    <ol style={css({ display: 'flex', flexDirection: 'column', justifyContent: 'space-between', flex: 1, listStyle: 'none', margin: 0, padding: 0 })}>
      {
        days.map((d, i) => (
          <li style="display:flex">
            <a
              data-rail-tick
              href={`#${dayAnchor(d.id)}`}
              aria-current={i === activeIndex ? 'location' : undefined}
              data-passed={i <= activeIndex ? '' : undefined}
              aria-label={`Día ${d.id} · ${cityName(d.citySlug)}`}
              style={css({
                '--dot': cityTone(d.citySlug),
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                minHeight: '24px',
                minWidth: '44px',
                paddingRight: '8px',
                borderRadius: '6px',
              })}
            >
              <span aria-hidden="true" style="display:flex;width:13px;justify-content:center"><span data-rail-dot></span></span>
              <span data-rail-tick-label aria-hidden="true">{d.id}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>
