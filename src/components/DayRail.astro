---
/**
 * DayRail — navegación sticky del journey (`<nav aria-label="Días del viaje">`).
 *
 * Escritorio: día activo (kanji, «Día» + número real del día —el mismo que «Día NN» de la
 * sección—, ciudad, fecha y posición «N de 21»), barra de progreso vertical y una lista de
 * enlaces reales `#dia-NN` (uno por día, zona táctil ≥ 24 px).
 * Móvil (≤ 860 px, reglas en index.css): rail compacto de 56 px con enlaces
 * anterior/siguiente, una línea «Día · ciudad · fecha» y la barra de progreso horizontal.
 *
 * Los enlaces usan la navegación nativa por ancla (scroll suave por CSS y `scroll-margin-top` en
 * las secciones), así que funcionan sin JS y actualizan la URL.
 *
 * Estado activo sin plantillas en JS (lo gobierna scripts/journey.ts):
 *  - Los 21 bloques de «día activo» ([data-rail-block]) y las 21 líneas compactas
 *    ([data-rail-line]) van pre-renderizados con `data-rail-day`; solo el del día activo no
 *    lleva `hidden` (sin JS, el primero).
 *  - Cada enlace del rail lleva `aria-current="location"` si es el activo y `data-passed` si ya
 *    se ha pasado; los estilos de los puntos salen de esos atributos (index.css, «Rail») y del
 *    color de la ciudad en `--dot`.
 *  - Anterior/siguiente: un enlace [data-rail-nav="prev|next"] (href y aria-label los actualiza
 *    el script) y su versión deshabilitada [data-rail-nav="prev-off|next-off"]; se alterna
 *    `hidden` entre ambos.
 *  - Barras de progreso [data-rail-progress="v|h"]: el script escribe su transform.
 */
import type { Day } from '@/data/types'
import { cities } from '@/data'
import { getCityMeta, formatShortDate, pad2, fontSerif } from '@/features/landing/theme'
import { dayAnchor } from '@/features/landing/scroll'
import { css } from '@/lib/style'

interface Props {
  days: readonly Day[]
}

const { days } = Astro.props

function cityName(slug: string): string {
  const raw = cities.find((c) => c.slug === slug)?.name ?? slug
  return raw.replace(/\s*\(.*\)/, '')
}

/** Día activo sin JS: el primero. */
const activeIndex = 0
const prev = activeIndex > 0 ? days[activeIndex - 1] : undefined
const next = activeIndex < days.length - 1 ? days[activeIndex + 1] : undefined

/** Botón redondo anterior/siguiente del rail móvil (oculto en escritorio por CSS). */
const dayNavStyle = {
  display: 'flex',
  flexShrink: 0,
  width: '40px',
  height: '40px',
  borderRadius: '50%',
  alignItems: 'center',
  justifyContent: 'center',
}
const prevStyle = { ...dayNavStyle, background: 'var(--surface)', border: '1px solid var(--border-cream)', color: 'var(--ink)' }
const nextStyle = { ...dayNavStyle, background: 'var(--primary-fill)', border: '1px solid var(--primary-fill)', color: '#fdf3e7' }
const disabled = { opacity: 0.4 }

const chevron = {
  prev: 'M15 18l-6-6 6-6',
  next: 'M9 18l6-6-6-6',
}
---

<nav
  data-rail
  aria-label="Días del viaje"
  style={css({
    position: 'sticky',
    top: 0,
    width: '196px',
    height: '100vh',
    flexShrink: 0,
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'center',
    gap: '22px',
    // Abajo deja sitio al ThemeToggle flotante (26 + 50 px) para que no tape los últimos días.
    padding: '30px 20px 92px',
    borderRight: '1px solid var(--border)',
    background: 'var(--surface-warm)',
    zIndex: 5,
  })}
>
  {/* Anterior (solo móvil vía CSS) */}
  <a
    data-day-nav
    data-rail-nav="prev"
    href={`#${dayAnchor((prev ?? days[0]).id)}`}
    aria-label={prev ? `Día anterior: día ${prev.id}` : undefined}
    hidden={!prev}
    style={css(prevStyle)}
  ><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron.prev} /></svg></a>
  <span data-day-nav data-rail-nav="prev-off" aria-hidden="true" hidden={!!prev} style={css(prevStyle, disabled)}
    ><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron.prev} /></svg></span
  >

  {/* Bloques de info del día activo (escritorio): uno por día, solo el activo visible */}
  {
    days.map((d, i) => (
      <div data-rail-block data-rail-day={d.id} hidden={i !== activeIndex} style={css({ display: 'flex', flexDirection: 'column', gap: '4px', position: 'relative' })}>
        <span
          data-rail-kanji
          aria-hidden="true"
          style={css({
            fontFamily: fontSerif,
            fontSize: '40px',
            lineHeight: 1,
            color: 'color-mix(in srgb, var(--ink) 13%, transparent)',
            fontWeight: 800,
            marginBottom: '6px',
          })}
        >{getCityMeta(d.citySlug).kanji}</span>
        <span
          style={css({
            fontSize: 'var(--text-label)',
            lineHeight: 'var(--text-label--line-height)',
            letterSpacing: 'var(--text-label--letter-spacing)',
            textTransform: 'uppercase',
            color: 'var(--amber-text)',
            fontWeight: 700,
          })}
        >Día</span>
        <span data-rail-num style={css({ fontFamily: fontSerif, fontWeight: 800, fontSize: '74px', lineHeight: 0.9, color: 'var(--ink)' })}>{pad2(d.id)}</span>
        <span style={css({ fontFamily: fontSerif, fontSize: '22px', color: 'var(--coral)', fontWeight: 600 })}>{cityName(d.citySlug)}</span>
        <span style={css({ fontSize: '13px', color: 'var(--muted2)', letterSpacing: '.04em' })}>{formatShortDate(d.date)}</span>
        <span data-rail-position style={css({ fontSize: '12px', color: 'var(--muted2)', fontVariantNumeric: 'tabular-nums' })}>{`${i + 1} de ${days.length}`}</span>
      </div>
    ))
  }

  {/* Barra de progreso vertical + enlaces por día (escritorio) */}
  <div data-prog-vertical style={css({ display: 'flex', gap: '14px', alignItems: 'stretch' })}>
    {/* Línea de progreso */}
    <div aria-hidden="true" style={css({ position: 'relative', width: '3px', background: 'var(--chip-cream)', borderRadius: '2px' })}>
      {/* A tamaño completo y escalada: el script escribe el transform (composited, sin layout) */}
      <div
        data-rail-progress="v"
        style={css({
          position: 'absolute',
          top: 0,
          left: 0,
          width: '100%',
          background: 'linear-gradient(180deg,var(--coral),var(--coral2))',
          borderRadius: '2px',
          height: '100%',
          transformOrigin: 'top',
          transform: 'scaleY(0)',
        })}
      ></div>
    </div>

    {/* Un enlace por día */}
    <ol style={css({ display: 'flex', flexDirection: 'column', justifyContent: 'space-between', flex: 1, listStyle: 'none', margin: 0, padding: 0 })}>
      {
        days.map((d, i) => (
          <li style="display:flex">
            <a
              data-rail-tick
              href={`#${dayAnchor(d.id)}`}
              aria-current={i === activeIndex ? 'location' : undefined}
              data-passed={i <= activeIndex ? '' : undefined}
              aria-label={`Día ${d.id} · ${cityName(d.citySlug)}`}
              style={css({
                '--dot': getCityMeta(d.citySlug).dot,
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                minHeight: '24px',
                minWidth: '44px',
                paddingRight: '8px',
                borderRadius: '6px',
              })}
            >
              <span aria-hidden="true" style="display:flex;width:13px;justify-content:center"><span data-rail-dot></span></span>
              <span data-rail-tick-label aria-hidden="true">{d.id}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {/* Línea compacta + barra de progreso horizontal (solo móvil vía CSS) */}
  <div data-prog-horizontal style={css({ display: 'flex', flex: 1, flexDirection: 'column', gap: '6px', minWidth: 0 })}>
    {
      days.map((d, i) => (
        <span
          data-rail-line
          data-rail-day={d.id}
          hidden={i !== activeIndex}
          style={css({ fontSize: '12.5px', color: 'var(--muted2)', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' })}
        ><strong style={css({ fontFamily: fontSerif, fontSize: '15px', color: 'var(--ink)', fontWeight: 800 })}>Día {pad2(d.id)}</strong> · <span style={css({ color: 'var(--coral)', fontWeight: 600 })}>{cityName(d.citySlug)}</span> · {formatShortDate(d.date)}</span>
      ))
    }
    <div aria-hidden="true" style={css({ position: 'relative', height: '4px', background: 'var(--chip-cream)', borderRadius: '2px' })}>
      <div
        data-rail-progress="h"
        style={css({
          position: 'absolute',
          left: 0,
          top: 0,
          height: '100%',
          background: 'linear-gradient(90deg,var(--coral),var(--coral2))',
          borderRadius: '2px',
          width: '100%',
          transformOrigin: 'left',
          transform: 'scaleX(0)',
        })}
      ></div>
    </div>
  </div>

  {/* Siguiente (solo móvil vía CSS) */}
  <a
    data-day-nav
    data-rail-nav="next"
    href={`#${dayAnchor((next ?? days[days.length - 1]).id)}`}
    aria-label={next ? `Día siguiente: día ${next.id}` : undefined}
    hidden={!next}
    style={css(nextStyle)}
  ><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron.next} /></svg></a>
  <span data-day-nav data-rail-nav="next-off" aria-hidden="true" hidden={!!next} style={css(nextStyle, disabled)}
    ><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron.next} /></svg></span
  >
</nav>
