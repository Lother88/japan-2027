---
/**
 * ZoneCard — ficha de una zona dentro de la hoja de un paso (StepSheet).
 *
 * Journey.astro la pinta una vez por zona dentro de un <template data-zone-tpl="id"> y
 * scripts/sheet.ts la clona al abrir un paso de esa zona (sin repetirla por día).
 *
 * Arriba, lo práctico (permitido sin plegar, NOSPOIL-02): nombre, tags, Acceso, Horario y
 * Notas de `Zone.practical`. Va en línea en el HTML: funciona sin conexión.
 * Debajo, «El lugar»: un <details data-spoiler> SIEMPRE plegado al abrir la hoja (el template
 * sale cerrado) con el cuerpo vacío. El contexto cultural de context.ts (qué es, historia,
 * significado y curiosidades de cada POI) se pide al desplegarlo: JSON estático en
 * `data-place-src` (pages/contexto/[zone].json.ts), pintado por scripts/place.ts. Así no pesa
 * en el HTML inicial. Sin fichas, no hay «El lugar».
 */
import type { Zone } from '@/data/types'
import { getContext } from '@/data/context'
import { tagLabel } from '@/data/tags'
import { firstKanji } from '@/features/landing/dayView'
import Icon from '@/components/Icon.astro'

interface Props {
  zone: Zone
}

const { zone } = Astro.props
const entries = getContext(zone.id) ?? []
const { access, hours, logistics } = zone.practical
const badge = firstKanji(entries[0]?.nombre ?? '') ?? zone.name.charAt(0)
// JSON estático de src/pages/contexto/[zone].json.ts (scripts/place.ts lo pide al desplegar)
const src = `${import.meta.env.BASE_URL}contexto/${zone.id}.json`
---

<div data-zone>
  <h3 data-zone-name>{zone.name}</h3>
  {
    zone.tags.length > 0 && (
      <ul data-zone-tags aria-label="Tipo de zona">
        {zone.tags.map((tag) => (
          <li>{tagLabel(tag)}</li>
        ))}
      </ul>
    )
  }
  {
    (access || hours) && (
      <dl data-zone-facts>
        {access && (
          <>
            <dt>Acceso</dt>
            <dd>{access}</dd>
          </>
        )}
        {hours && (
          <>
            <dt>Horario</dt>
            <dd>{hours}</dd>
          </>
        )}
      </dl>
    )
  }
  {
    logistics && logistics.length > 0 && (
      <ul data-zone-notes aria-label="Notas prácticas">
        {logistics.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    )
  }

  {
    entries.length > 0 && (
      <details data-spoiler data-place data-place-src={src}>
        <summary>
          <span data-place-k aria-hidden="true">{badge}</span>
          <span data-place-tx>
            <b>El lugar</b>
            <small>Qué es, historia y curiosidades</small>
          </span>
          <span data-spoiler-chev><Icon name="chev" size={22} /></span>
        </summary>
        <div data-place-body aria-live="polite"></div>
      </details>
    )
  }
</div>
