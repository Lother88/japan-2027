---
/**
 * RouteSection — banda «La ruta», entre el hero y el itinerario.
 *
 * Abre con la banda «Muro» (muro de piedra con tejadillo, pinos y tōrō) que hace de transición
 * desde el hero; después, la cabecera con el spot de la vía y el mapa MapLibre de la ruta.
 *
 * - La banda y el spot se descargan al acercarse al viewport (scripts/lazy-art.ts).
 * - El mapa (MapLibre) se carga solo cuando su caja [data-route-map] entra en pantalla
 *   (scripts/map.ts); la leyenda y la marca de agua ya van en el HTML.
 * - Pantalla completa: el mapa pasa a `position: fixed` (z-index 1000). Ningún ancestro crea
 *   contexto de apilamiento ni bloque contenedor (sin z-index, transform, filter ni contain),
 *   así que el modal cubre también el rail y los botones flotantes sin portal.
 */
import { tripSummary } from '@/data/trip'
import { ROUTE_ANCHOR } from '@/features/landing/scroll'
import { css } from '@/lib/style'
import ArtBox from '@/components/ArtBox.astro'

const trip = tripSummary()
---

<section id={ROUTE_ANCHOR} aria-labelledby="ruta-titulo" data-route>
  <ArtBox name="banda" src="banda" defer pauseOffscreen preserveAspectRatio="xMidYMax slice" />

  <div data-route-inner>
    <div data-route-head>
      <ArtBox name="ruta" src="ruta" defer pauseOffscreen style={{ width: '120px', height: '72px' }} />
      <div>
        <h2
          id="ruta-titulo"
          style={css({
            fontFamily: 'var(--font-serif)',
            fontWeight: 800,
            fontSize: 'var(--text-h2)',
            lineHeight: 'var(--text-h2--line-height)',
            color: 'var(--ink)',
            margin: 0,
          })}
        >La ruta</h2>
        <p style={css({ margin: '6px 0 0', fontSize: '14px', color: 'var(--slate)' })}>
          {trip.days} días · {trip.bases} bases · {trip.excursions} excursiones
        </p>
      </div>
    </div>

    <div data-route-map>
      {/* Leyenda */}
      <div
        data-legend
        style={css({
          position: 'absolute',
          top: '14px',
          left: '14px',
          zIndex: 5,
          pointerEvents: 'none',
          border: '1px solid var(--border-2)',
          borderRadius: '9px',
          padding: '9px 13px',
          boxShadow: '0 4px 14px -6px rgba(0,0,0,.25)',
          display: 'flex',
          flexDirection: 'column',
          gap: '4px',
          fontSize: '11.5px',
          color: 'var(--slate)',
        })}
      >
        <span style={css({ display: 'flex', alignItems: 'center', gap: '7px' })}>
          <span style={css({ width: '18px', height: '3px', borderRadius: '2px', background: 'var(--map-line)' })}></span>
          Recorrido principal
        </span>
        <span style={css({ display: 'flex', alignItems: 'center', gap: '7px' })}>
          <span style={css({ width: '18px', height: 0, borderTop: '2px dashed var(--amber-deep)', display: 'inline-block' })}></span>
          Excursión de día
        </span>
      </div>

      {/* Marca de agua */}
      <div
        data-watermark
        aria-hidden="true"
        style={css({
          position: 'absolute',
          bottom: '14px',
          left: '14px',
          zIndex: 5,
          fontFamily: 'var(--font-serif)',
          fontSize: '30px',
          fontWeight: 800,
          pointerEvents: 'none',
        })}
      >日本一周</div>
    </div>
  </div>
</section>
