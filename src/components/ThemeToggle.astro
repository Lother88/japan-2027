---
/**
 * ThemeToggle — botón flotante (abajo-izquierda) para alternar claro/oscuro.
 *
 * Dentro lleva el spot isométrico de un tōrō (32 px): apagado en claro y encendido en oscuro.
 * El aspecto según el tema lo pone el CSS del propio SVG (`[data-theme="dark"] .iso-spot-toro-toggle`),
 * sin intercambiar iconos. scripts/theme.ts dispara la transición de tema con el propio botón
 * como origen y mantiene el nombre accesible, que describe la acción (no el estado):
 * «Activar tema oscuro/claro». El HTML sale con el del tema claro.
 * En móvil, sobre el itinerario, se aparta al bajar leyendo (journey.ts + index.css).
 */
import { css } from '@/lib/style'
import ArtBox from '@/components/ArtBox.astro'

const label = 'Activar tema oscuro'
---

<button
  type="button"
  data-ttoggle
  aria-label={label}
  title={label}
  style={css({
    position: 'fixed',
    bottom: '26px',
    left: '26px',
    zIndex: 85,
    width: '50px',
    height: '50px',
    borderRadius: '50%',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    background: 'var(--surface)',
    color: 'var(--ink)',
    border: '1px solid var(--border)',
    boxShadow: '0 8px 22px -10px rgba(0,0,0,.4)',
    cursor: 'pointer',
  })}
>
  <ArtBox name="toggle" src="toro-toggle" style={{ width: '32px', height: '32px' }} />
</button>
