---
/**
 * Hero — sección principal (header) de la landing.
 *
 * Fondo --paper liso con la maqueta isométrica (HeroArt) a la derecha y, en la zona segura de
 * la izquierda, el texto: hojas de calendario con la cuenta atrás (HeroDates), 日本 en vertical
 * con el sello del año, H1, subtítulo, párrafo, tira de billete con las cifras derivadas de los
 * datos (HeroSpots) y el CTA [data-cta], que baja a la banda «La ruta». En móvil el arte pasa
 * encima del título. Debajo, el aviso «Desplázate» [data-scrollcue] con el poste michishirube.
 *
 * Los clics del CTA y del aviso los atiende scripts/hero.ts, que además congela el movimiento
 * ambiental del arte (data-art-paused) cuando la portada sale de pantalla. La maquetación
 * responsive vive en index.css (`[data-hero…]`).
 */
import { calendarDay, numberWord, tripSummary } from '@/data/trip'
import { css } from '@/lib/style'
import ArtBox from '@/components/ArtBox.astro'
import HeroArt from '@/components/HeroArt.astro'
import HeroDates from '@/components/HeroDates.astro'
import HeroSpots from '@/components/HeroSpots.astro'

const trip = tripSummary()
/** Año del sello: el de la salida */
const year = calendarDay(trip.departure).year
---

<header data-hero>
  {/*
    El texto va ANTES que la maqueta en el HTML: la maqueta en línea son ~350 KB de SVG y, si
    fuera delante, el primer pintado podía llegar sin el kanji 日本 (el LCP) todavía analizado.
    La posición visual no cambia (index.css: misma celda del grid en escritorio con el texto
    encima por z-index; en móvil la maqueta sube con `order`).
  */}
  <div data-hero-stage>
    {/* Texto en la zona segura del lienzo (x 0–470 de 1200) */}
    <div data-hero-copy>
      <HeroDates />

      {/* 日本 en vertical (decorativo) junto al sello, el H1 y el subtítulo */}
      <div data-hero-title>
        <span data-hero-kanji lang="ja" aria-hidden="true">日本</span>
        <div data-hero-title-side>
          <span data-hanko aria-hidden="true">{year}</span>
          <h1>Japón</h1>
          <p data-hero-sub><span>Tres semanas,</span> <br /><span>una vuelta completa.</span></p>
        </div>
      </div>

      <p data-hero-lead>
        Del neón de Tokio a los templos de Kioto, y vuelta: {trip.days} días en tren por {numberWord(trip.bases)} bases, <strong>entre lo más moderno y lo más tradicional</strong>.
      </p>

      <HeroSpots />

      {/* CTA: baja a la banda «La ruta». Fondo, hover y presión en index.css ([data-cta]) */}
      <button
        type="button"
        data-cta
        style={css({
          marginTop: '20px',
          display: 'inline-flex',
          alignItems: 'center',
          gap: '11px',
          color: '#fdf3e7',
          border: 'none',
          borderRadius: '10px',
          padding: '15px 26px',
          fontFamily: 'var(--font-sans)',
          fontWeight: 700,
          fontSize: '15px',
          cursor: 'pointer',
        })}
      >
        Explora la ruta
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fdf3e7" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </button>
    </div>

    <HeroArt />
  </div>

  {/* Aviso de scroll: salta al itinerario; el poste indicador oscila (CSS del SVG) */}
  <button type="button" data-scrollcue aria-label="Desplázate hasta el itinerario">
    <span
      style={css({
        fontSize: 'var(--text-label)',
        lineHeight: 'var(--text-label--line-height)',
        letterSpacing: 'var(--text-label--letter-spacing)',
        textTransform: 'uppercase',
      })}
    >Desplázate</span>
    <ArtBox name="scrollcue" src="michishirube" style={{ width: '48px', height: '64px' }} />
  </button>
</header>
