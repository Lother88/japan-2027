---
/**
 * Base — documento HTML de la landing: <head> (meta, SEO y Open Graph, fuentes, script
 * anti-FOUC del tema) y el CSS global (src/styles/index.css, que Astro empaqueta y enlaza).
 */
import '@/styles/index.css'

interface Props {
  title?: string
  description: string
}

const { title = 'Japón 2027', description } = Astro.props
// URL absolutas a partir de `site` (astro.config.mjs): canonical y Open Graph las exigen
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    {/* viewport-fit=cover: la tira de fechas y la hoja de cada paso respetan env(safe-area-inset-*) */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Color de la barra del navegador: el --paper de cada tema */}
    <meta name="theme-color" content="#fbf6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12141b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maqueta isométrica del hero: monte Fuji, shinkansen y torii, con el título Japón 2027" />
    <meta name="twitter:card" content="summary_large_image" />
    {/*
      Fuentes autoalojadas y recortadas (tools/fonts/build.mjs; @font-face en index.css). Se
      precargan las que pintan el primer pantallazo casi entero: serif 800 latino («Japón»,
      cifras del calendario), sans 400 latino (texto) y el trozo de 日本 del hero, que es el
      LCP (así se pinta con su fuente desde el primer fotograma). El resto llega por el CSS.
    */}
    <link rel="preload" href="/fonts/shippori-mincho-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-kaku-gothic-new-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/shippori-mincho-800-hero.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      Script en línea y síncrono antes del primer pintado. Anti-FOUC del tema: lee el tema
      guardado (localStorage «jp-theme») o, si no hay, prefers-color-scheme, y fija
      data-theme en <html> para que las variables de index.css resuelvan ya a esa paleta.
      Además deja el scroll instantáneo mientras carga la página.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('jp-theme')
          if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          }
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          // Sin acceso a localStorage: en el peor caso, un destello breve en la primera carga
        }
      })()
      // Scroll instantáneo hasta que acaba la carga (index.css, [data-scroll-instant]): un enlace
      // directo /#dia-NN aterriza en el día sin recorrer la página animada desde arriba.
      ;(function (root) {
        root.setAttribute('data-scroll-instant', '')
        addEventListener('load', function () {
          requestAnimationFrame(function () {
            root.removeAttribute('data-scroll-instant')
          })
        })
      })(document.documentElement)
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
