---
/**
 * Base — documento HTML de la landing: <head> (meta, fuentes, script anti-FOUC del tema) y el
 * CSS global (src/styles/index.css, que Astro empaqueta y enlaza en el <head>).
 */
import '@/styles/index.css'

interface Props {
  title?: string
}

const { title = 'Japón 2027' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {/*
      Fuentes autoalojadas y recortadas (tools/fonts/build.mjs; @font-face en index.css). Se
      precargan solo las dos que pinta el primer pantallazo casi entero: serif 800 latino
      («Japón», cifras del calendario) y sans 400 latino (texto). El resto llega por el CSS.
    */}
    <link rel="preload" href="/fonts/shippori-mincho-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-kaku-gothic-new-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      Script en línea y síncrono antes del primer pintado. Anti-FOUC del tema: lee el tema
      guardado (localStorage «jp-theme») o, si no hay, prefers-color-scheme, y fija
      data-theme en <html> para que las variables de index.css resuelvan ya a esa paleta.
      Además deja el scroll instantáneo mientras carga la página.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('jp-theme')
          if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          }
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          // Sin acceso a localStorage: en el peor caso, un destello breve en la primera carga
        }
      })()
      // Scroll instantáneo hasta que acaba la carga (index.css, [data-scroll-instant]): un enlace
      // directo /#dia-NN aterriza en el día sin recorrer la página animada desde arriba.
      ;(function (root) {
        root.setAttribute('data-scroll-instant', '')
        addEventListener('load', function () {
          requestAnimationFrame(function () {
            root.removeAttribute('data-scroll-instant')
          })
        })
      })(document.documentElement)
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
