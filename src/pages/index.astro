---
/**
 * Landing del itinerario «Japón 2027» (página única de scroll).
 *
 * Composición: skip-link («Saltar al itinerario») · un único <main> con el hero, la banda
 * «La ruta» con el mapa y el journey (rail + secciones por día) · footer fuera de <main> ·
 * botón para volver arriba · interruptor flotante de tema claro/oscuro.
 */
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import RouteSection from '@/components/RouteSection.astro'
import Journey from '@/components/Journey.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import ToTop from '@/components/ToTop.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
---

<Base>
  <a class="skip-link" href="#itinerario">Saltar al itinerario</a>
  <main>
    <Hero />
    <RouteSection />
    <Journey />
  </main>
  <SiteFooter />
  <ToTop />
  <ThemeToggle />
  <script>
    // Comportamiento (Astro lo empaqueta en un único módulo): tema, día activo del rail y
    // progreso, aparición de bloques, botones de navegación, cuenta atrás, arte diferido y,
    // al llegar a su caja, el mapa (MapLibre en su propio chunk).
    import '@/scripts/theme'
    import '@/scripts/journey'
    import '@/scripts/reveal'
    import '@/scripts/nav'
    import '@/scripts/countdown'
    import '@/scripts/lazy-art'
    import '@/scripts/map'
  </script>
</Base>
