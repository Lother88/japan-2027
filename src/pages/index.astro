---
/**
 * Landing del itinerario «Japón 2027» (página única de scroll).
 *
 * Composición: skip-link («Saltar al itinerario») · un único <main> con el hero, la banda
 * «La ruta» con el mapa y el journey (rail / tira de fechas + secciones por día) · footer fuera
 * de <main> · botón para volver arriba · interruptor flotante de tema claro/oscuro · la hoja de
 * cada paso del plan (hija directa de <body>: al abrirla, el resto se vuelve inert).
 */
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import RouteSection from '@/components/RouteSection.astro'
import Journey from '@/components/Journey.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import ToTop from '@/components/ToTop.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import StepSheet from '@/components/StepSheet.astro'
import { tripSummary } from '@/data/trip'

const trip = tripSummary()
// Resumen para buscadores y tarjetas al compartir (meta description y Open Graph)
const description = `Itinerario de ${trip.days} días por Japón en tren (${trip.dateRange}): de Tokio a Kioto y vuelta por ${trip.bases} bases y ${trip.excursions} excursiones, con la ruta en el mapa y el plan día a día.`
---

<Base description={description}>
  <a class="skip-link" href="#itinerario">Saltar al itinerario</a>
  <main>
    <Hero />
    <RouteSection />
    <Journey />
  </main>
  <SiteFooter />
  <ToTop />
  <ThemeToggle />
  <StepSheet />
  <script>
    // Comportamiento (Astro lo empaqueta en un único módulo): tema, día activo del rail y de la
    // tira de fechas, plan de hoy («Ahora / Después», pasos hechos), hoja de cada paso, «El
    // lugar» bajo demanda, aparición de bloques, botones de navegación, cuenta atrás, arte
    // diferido y, al llegar a su caja, el mapa (MapLibre en su propio chunk).
    import '@/scripts/theme'
    import '@/scripts/journey'
    import '@/scripts/day-plan'
    import '@/scripts/sheet'
    import '@/scripts/place'
    import '@/scripts/reveal'
    import '@/scripts/nav'
    import '@/scripts/countdown'
    import '@/scripts/lazy-art'
    import '@/scripts/map'
  </script>
</Base>
